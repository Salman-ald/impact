---
const { theme = "light", activePage = "" } = Astro.props;

let logo;

if (theme === "transparent") {
    logo = "/images/logo-white.png";
} else {
    logo = "/images/logo-black.png";
}
---

<header class={theme}>
    <a class="logo" href="/">
        <img src={logo} alt="Logo" width="100" height="100">
    </a>
    <nav class="nav-menu">
        <a href="/about">ABOUT</a>
        <a href="/program">Program</a>
        <a href="/tickets">TICKETS</a>
        <a href="/newsletter">NEWSLETTER</a>
    </nav>

    <button class="burger" aria-label="Open menu">
        ☰
    </button>

</header>

<style>
    header {
        display: flex;
        padding: 0px;
        border-top: 2px solid #000;
        border-bottom: 2px solid #000;
        padding: 0px;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
    }

    header.transparent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    border: none;
    background: transparent;
    box-sizing: border-box;    
}

    header.transparent nav a {
        color: white;
    }

    .logo{
        flex-shrink: 0;
    }
.logo img{
    padding-left: 37px;
    height: 50px;
    width: auto;
    display: block;

}

    nav{
        display: flex;
        gap: 30px;
    }

    nav a{
        color:black;
        text-decoration: none;
        font-size: 14px;
    }


    .burger {
        display: none;
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
    color: black;
    }

header.light .burger {
    color: black;
}

header.transparent .burger {
    color: white;
}


@media (max-width: 768px) {
     .nav-menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;

    gap: 30px;
    z-index: 20;

    /* Fade */
    opacity: 40%;
    visibility: hidden;
    transition: 0.3s ease-in-out;
    }

    .nav-menu.open{
        opacity: 1;
        visibility: visible;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: fixed;
        top: 100%;
        left: 0;
        top: 0;
        height: 100vh;
        width: 100%;
        background-color: black;
        padding: 30px;
        box-sizing: border-box;
        gap: 45px;
    }
 .nav-menu.open a{
    color: white;
        font-size: 30px;
        text-decoration: none;
    }


    .burger {
        display: block;
        position: relative;
        z-index: 30;
    }

    header:has(.nav-menu.open) .burger {
    color: white;
}
}

</style>

<script>
    const burger = document.querySelector(".burger");
    const nav = document.querySelector(".nav-menu");

    burger?.addEventListener("click", () => {
        nav?.classList.toggle("open");
    });
</script>