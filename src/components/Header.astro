---
const { theme = "light", activePage = "" } = Astro.props;

let logo;

if (theme === "transparent") {
    logo = "/images/logo-white.png";
} else {
    logo = "/images/logo-black.png";
}
---

<header class={theme}>
    <a class="logo" href="/">
        <img src={logo} alt="Logo" width="100" height="100">
    </a>
    <nav>
        <a href="/about">ABOUT</a>
        <a href="/program">Program</a>
        <a href="/tickets">TICKETS</a>
        <a href="/newsletter">NEWSLETTER</a>
    </nav>
</header>

<style>
    header {
        display: flex;
        padding: 0px;
        border-top: 2px solid #000;
        border-bottom: 2px solid #000;
        padding: 0px;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
    }

    header.transparent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    border: none;
    background: transparent;
    box-sizing: border-box;    
}

    header.transparent nav a {
        color: white;
    }

    .logo{
        flex-shrink: 0;
    }
.logo img{
    padding-left: 37px;
    height: 50px;
    width: auto;
    display: block;

}

    nav{
        display: flex;
        gap: 30px;
    }

    nav a{
        color:black;
        text-decoration: none;
        font-size: 14px;
    }
</style>