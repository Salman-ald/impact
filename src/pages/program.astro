---
	import Header from '../components/Header.astro';
	import Footer from '../components/Footer.astro';
---
<html lang="en">
  <head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>IMPACT Festival</title>
  </head>
  <body>
	<Header theme="light"/>



	
	<section class="program">
		<div><h1>PROGRAM</h1></div>
		<div class="buttons">
			<button class="active" data-filter="all">ALL</button>
			<button data-filter="talks">TALKS</button>
			<button data-filter="music">MUSIC</button>
			<button data-filter="workshops">WORKSHOPS</button>
			<button data-filter="food">FOOD</button>
		</div>

		<div class="program-content" data-category="all">

    <div class="program-grid">

        <div class="program-card" data-filter="talks">
            <img src="/images/program/talks.jpg" alt="talks">
            <div class="card-info">
                <span>SAT 12 SEP</span>
                <span>16:00</span>
                <span>→</span>
            </div>
            <strong>TALKS</strong>
        </div>

        <div class="program-card" data-filter="music">
            <img src="/images/program/music.jpg" alt="Music">
            <div class="card-info">
                <span>SAT 12 SEP</span>
                <span>19:00</span>
                <span>→</span>
            </div>
            <strong>MUSIC</strong>
        </div>

        <div class="program-card" data-filter="workshops">
            <img src="/images/program/workshop.jpg" alt="Workshop">
            <div class="card-info">
                <span>SAT 12 SEP</span>
                <span>15:00</span>
                <span>→</span>
            </div>
            <strong>WORKSHOPS</strong>
        </div>

        <div class="program-card" data-filter="food">
            <img src="/images/program/food.jpg" alt="Food">
            <div class="card-info">
                <span>SAT 12 SEP</span>
                <span>18:00</span>
                <span>→</span>
            </div>
            <strong>FOOD</strong>
        </div>

    </div>

</div>



	</section>
	<Footer />
  </body>
  </html>

  <style>

@font-face {
	font-family: 'Impact';
	src: url('/fonts/CC79.ttf') format('truetype');
}

.program h1 {
	font-family: 'Impact', sans-serif;
	font-size: 60px;
	font-weight: normal;
	text-align: center;
	margin-bottom: 20px;}

.program-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
}

@media (max-width: 768px) {
	.program-grid {
		grid-template-columns: repeat(2, 1fr);
		gap: 10px;
	}

	.program h1 {
		font-size: 50px;
	}
}


.program-card {
	cursor: pointer;
	transition: transform 0.3s ease;
}


@media (min-width: 769px) {
	.program-card:hover {
		transform: scale(1.05);
	}
}

.program-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
}

.card-info {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 12px;
}

.program-card strong {
    font-size: 12px;
}
	body {
		font-family: Arial;
		margin: 0;
		max-width: 100%;
	}

	h1{
		font-size:60px;
	}

	button{
		background-color: #ffff;
		color: rgb(0, 0, 0);
		padding: 10px 20px;
		margin: 5px;
		cursor: pointer;
		font-size: 16px;
		border-radius: 50px;
		border: 1px solid #cfcfcf;
	}

	button:hover {
		background-color: #ff0000;
		transition: ease-in-out 0.3s;
	}

	button.active {
		background-color: #ff0000;
		color: #fff;
		border: none;
	}

	.buttons{
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 20px;
		justify-content: center;
	}

	.program{
		margin-left: 3%;
		margin-right: 3%;
		flex-direction: column;
		align-items: center;
		margin-top: 100px;
	}
	</style>

	<script>
    const buttons = document.querySelectorAll('.buttons button');
    const content = document.querySelectorAll('.program-content');
    const cards = document.querySelectorAll('.program-card');

    function filterProgram(filter) {

        // Change active/red button
        buttons.forEach((button) => {
            button.classList.remove("active");

            if (button.dataset.filter === filter) {
                button.classList.add("active");
            }
        });

        // Show the correct content
        content.forEach((section) => {
            if (section.dataset.category === filter) {
                section.style.display = "block";
            } else {
                section.style.display = "none";
            }
        });
    }


    // Filter buttons
    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            filterProgram(button.dataset.filter);
        });
    });


    // Program cards
    cards.forEach((card) => {
        card.addEventListener("click", () => {
            filterProgram(card.dataset.filter);
        });
    });
</script>