---
	import Header from '../components/Header.astro';
	import Footer from '../components/Footer.astro';
---
<html lang="en">
  <head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>IMPACT Festival</title>
  </head>
  <body>
	<Header theme="transparent"/>
	<main>
		<section class="hero">
			<div class="hero-content">
				<img
				class="hero-overlay"
				src="/images/overlay.png"
				alt="Impact festival 11-12 september 2026"
			/>
			<div class="red-text">
				<p>MUSIC // ART // TALKS // WORKSOHPS // FOOD <br/>DESIGNED TO INCREASE OUT IMPACT</p>
			</div>
			<button class="buttons">
			<div class="ticket-button1" >TICKETS</div>
			<a class="ticket-button2" href="program">PROGRAM</a>
			</button>

			</div>
		</section>
		<section class="img-wall">
			<a href="https://www.instagram.com/p/Dc4M-ERkaQc/" target="_blank">
				<img src="/images/collage/img1.jpeg" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/DdIzHhODCC4/" target="_blank">
				<img src="/images/collage/img2.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/DdBRYb_kUB9/" target="_blank">
				<img src="/images/collage/img3.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/DdLnEF3kQEY/" target="_blank">
				<img src="/images/collage/img4.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/Dc5edgsjNEN/" target="_blank">
				<img src="/images/collage/img5.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/Dc8BiUMjEU9/" target="_blank">
				<img src="/images/collage/img6.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/Dc-pvM7kcLD/" target="_blank">
				<img src="/images/collage/img7.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/Dc6TGGsDFKV/" target="_blank">
				<img src="/images/collage/img8.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/Dc1oJ-dkTpd/" target="_blank">
				<img src="/images/collage/img9.webp" alt="Collage of festival images" />
			</a>
			<a href="https://www.instagram.com/p/DdFFGvrkQDk/" target="_blank">
				<img src="/images/collage/img10.jpeg" alt="Collage of festival images" />
			</a>

		</section>
	</main>
	<Footer />
  </body>
  </html>

  <style>

	.img-wall {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 18px;
		max-width: 93%;
		align-items: center;
		margin: 0 auto;
		margin-top: 150px;
	}

.img-wall img {
	width: 100%;
	height: auto;
	object-fit: cover;
}

@media (max-width: 768px) {
  .img-wall {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 60px 20px;
	margin-top: 0;
  }
}


	.red-text {
color: red;	}

	body {
		font-family: Arial;
		margin: 0;
	}

	p {
		font-size: 22px;
		font-weight: bold;
	}

	.hero {
		min-height: 100vh;
		background-image: url("/images/koncert.png");
		background-size: cover;
		background-position: center;
		padding: 40px;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.hero-content {
		display: flex;
  		flex-direction: column;
  		align-items: center;
  		gap: 0px;
	}

	.hero-content {
		color: white;
		text-align: center;
	}

	.hero-overlay {
		 width: 100%;
  max-width: 1000px;
  height: auto;
}

.buttons {
  display: flex;
  gap: 20px;
  justify-content: center;
   background: none;
   border: none;
 
}

.ticket-button1 {
  display: flex;
  gap: 20px;
  justify-content: center;
  padding: 18px 70px;
  background: red;
  color: white;
  text-decoration: none;
  border-radius: 50px;
}

.ticket-button1:hover {
  background: #545454;
  transition: 0.3s;
}

.ticket-button2 {
  display: flex;
  gap: 20px;
  justify-content: center;
  padding: 18px 70px;
  background: rgba(255, 0, 0, 0);
  color: white;
  border: 1px solid rgb(255, 255, 255);
  text-decoration: none;
  border-radius: 50px;
}

.ticket-button2:hover {
  background: #545454;
  transition: 0.3s;
}

	h1{
		font-size:60px;
	}

	@font-face {
		font-family: 'impact';
		src: url('/fonts/CC79.ttf') format('truetype');
	}

	.impact-text {
		font-family: 'impact';
	}

	@font-face {
		font-family: 'festival';
		src: url('/fonts/CC26.ttf') format('truetype');
	}

	.festival-text {
		font-family: 'festival';
	}

	</style>

